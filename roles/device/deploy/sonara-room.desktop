# Room display in kiosk mode after desktop login. Install:
#   cp roles/device/deploy/sonara-room.desktop ~/.config/autostart/
[Desktop Entry]
Type=Application
Name=Sonara room display
Exec=sh -c 'gsettings set org.gnome.desktop.session idle-delay 0; gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type nothing; gsettings set org.gnome.desktop.screensaver lock-enabled false; xset s off -dpms s noblank 2>/dev/null; for i in $(seq 1 60); do curl -sf http://localhost:8000/api/health >/dev/null && break; sleep 2; done; exec chromium --kiosk --noerrdialogs --disable-session-crashed-bubble --no-first-run --password-store=basic http://localhost:8000/room'
X-GNOME-Autostart-enabled=true
